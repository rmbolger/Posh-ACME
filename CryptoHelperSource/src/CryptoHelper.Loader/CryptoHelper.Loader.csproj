<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!--
    The loader is only used on PowerShell 7, WinPS loads CryptoHelper.dll
    directly as it has no concept of an ALC.
    -->
    <TargetFramework>net6.0</TargetFramework>
    <!--Not needed but makes it nicer to write in C# at this version-->
    <LangVersion>10.0</LangVersion>
    <!--Not needed but using Nullable is highly recommended-->
    <Nullable>enable</Nullable>

    <Deterministic>true</Deterministic>
    <EnableSourceLink>false</EnableSourceLink>
    <PathMap>$(MSBuildThisFileDirectory)=/_/</PathMap>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    <EmbedAllSources>true</EmbedAllSources>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
</Project>
